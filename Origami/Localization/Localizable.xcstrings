    "When enabled, every Peek sends page excerpts to your configured lightweight model. Credibility also uses web search. Provider charges may apply, including in private windows. These preferences apply to future previews until switched off." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, every Peek sends page excerpts to your configured lightweight model. Credibility also uses web search. Provider charges may apply, including in private windows. These preferences apply to future previews until switched off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，每次 Peek 都会将页面摘录发送至你配置的轻量模型。可信度评估还会使用网页搜索。服务提供商可能收费，无痕窗口也不例外。这些设置将应用于之后的预览，直到关闭。"
          }
        }
      }
    },
