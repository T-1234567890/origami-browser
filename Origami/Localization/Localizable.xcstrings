    "Apple Passwords could not complete this request (code %@). Website password access through this API requires an approved app–website association. Origami cannot offer Safari-style password access through this request alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
