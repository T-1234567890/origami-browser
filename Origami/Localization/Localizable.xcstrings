          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 密码无法完成此请求（代码 %@）。通过此 API 访问网站密码需要获批准的应用与网站关联。仅凭此请求，Origami 无法提供 Safari 式密码访问。"
          }
        }
      }
    },
    "Applies to browsing history, recently closed tabs, and inactive Ask histories across profiles. Cookies, website data, bookmarks and downloads are kept. Shortening this period deletes older history immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to browsing history, recently closed tabs, and inactive Ask histories across profiles. Cookies, website data, bookmarks and downloads are kept. Shortening this period deletes older history immediately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于所有个人资料的浏览历史记录、最近关闭的标签页和非活跃提问记录。保留 Cookie、网站数据、书签和下载。缩短保留期限将立即删除较早的记录。"
          }
        }
      }
    },
